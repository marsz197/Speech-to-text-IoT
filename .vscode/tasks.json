{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Uvicorn Server",
            "type": "shell",
            "command": ".venv\\Scripts\\python",
            "args": ["-m", "uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(Uvicorn running|INFO:).*",
                    "endsPattern": "^.*Application startup complete.*"
                }
            }
        }
    ]
}
